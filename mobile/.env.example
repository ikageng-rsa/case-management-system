# --- API base URL (Laravel API v1) ---
# Always the /api/v1 root of the firm's backend. Release builds require https://.
#   Local Laravel, Expo web / iOS simulator : http://127.0.0.1:8000/api/v1
#   Local Laravel, Android emulator         : http://10.0.2.2:8000/api/v1
#   Local Laravel, physical phone           : http://<your-PC-LAN-IP>:8000/api/v1   (run: php artisan serve --host=0.0.0.0)
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:8000/api/v1
EXPO_PUBLIC_API_TIMEOUT_MS=15000

# --- Features the v1 API does not offer yet (off by default) ---
# Comma separated: notifications, documents, passwordReset, signOut. See src/config/features.ts.
# EXPO_PUBLIC_API_FEATURES=

# --- Notifications (SMS / email / push are sent by the BACKEND only) ---
# The app holds no SMS or email provider keys. It registers its device token with POST /devices
# and shows the server inbox (GET /notifications). Token type the app registers:
#   native (default: FCM on Android, APNs on iOS - needs a dev/production build) | expo (Expo Go testing)
# EXPO_PUBLIC_PUSH_TOKEN_TYPE=native

# --- Security ---
# Seconds in the background before the app lock asks for biometrics / device PIN again.
# EXPO_PUBLIC_APP_LOCK_AFTER_SECONDS=60
# Erase the encrypted offline cache on sign-out (default: kept so offline work survives; unsynced items are never wiped silently).
# EXPO_PUBLIC_WIPE_CACHE_ON_LOGOUT=false
# Dev only: allow screenshots / screen recording (blocked by default).
# EXPO_PUBLIC_ALLOW_SCREENSHOTS=false

# --- Offline mode ---
# Queue edits to EXISTING records while offline too (default: only adding is allowed offline; last write wins on sync).
# EXPO_PUBLIC_OFFLINE_EDITS=false
# Days an offline sign-in stays valid without an online sign-in.
# EXPO_PUBLIC_OFFLINE_LOGIN_DAYS=14
