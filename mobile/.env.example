# --- API base URL ---
# Mock API (npm run api), pick the one that matches where the app runs:
#   Expo web / iOS simulator : http://localhost:8000/api
#   Android emulator         : http://10.0.2.2:8000/api
#   Physical phone           : http://<your-PC-LAN-IP>:8000/api   (same Wi-Fi; the server prints it)
# Real backend: https://legalcms-dev.contoso.co.za/api
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api
EXPO_PUBLIC_API_TIMEOUT_MS=15000

# Demo login: always on in dev builds; set to true to also allow it in a release build.
# EXPO_PUBLIC_ENABLE_DEMO_LOGIN=false
# EXPO_PUBLIC_DEMO_EMAIL=demo@legalcms.co.za
# EXPO_PUBLIC_DEMO_PASSWORD=Demo@1234

# --- SMS (overdue alerts + SMS 2FA) ---
# none (default) | backend (POST /notifications/sms, server holds the keys - recommended)
# | textbelt (free key "textbelt" = 1 SMS/day, demo only) | africastalking (free SANDBOX only)
# Keys in EXPO_PUBLIC_* are readable from the app binary - never put a live paid key here.
# EXPO_PUBLIC_SMS_PROVIDER=none
# EXPO_PUBLIC_TEXTBELT_KEY=textbelt
# EXPO_PUBLIC_AT_USERNAME=sandbox
# EXPO_PUBLIC_AT_API_KEY=

# --- Offline mode ---
# Queue edits to EXISTING records while offline too (default: only adding is allowed offline; last write wins on sync).
# EXPO_PUBLIC_OFFLINE_EDITS=false
# Days an offline sign-in stays valid without an online sign-in.
# EXPO_PUBLIC_OFFLINE_LOGIN_DAYS=14
